# Copy this file to .env and fill in real values for local development.
# Never commit a real .env file with actual secrets.

# --- General application settings -------------------------------------------
APP_NAME=Document Intelligence Platform
ENVIRONMENT=local
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# --- File validation limits (case-study §3 / §4.1) ---------------------------
MAX_FILE_SIZE_MB=10
MAX_PAGE_COUNT=3
ALLOWED_CONTENT_TYPES=application/pdf,image/jpeg,image/png

# --- LLM / extraction provider (used by the extraction layer, added later) --
# LLM_PROVIDER=anthropic | openai | none
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL_NAME=
LLM_REQUEST_TIMEOUT_SECONDS=60

# --- OCR provider (optional corroboration path, added later) ----------------
# OCR_PROVIDER=none | tesseract | ocr_space
OCR_PROVIDER=none
OCR_SPACE_API_KEY=

# --- Persistence (database wiring added later) -------------------------------
DATABASE_URL=sqlite:///./document_intelligence.db

# --- CORS (frontend origin, added later) -------------------------------------
CORS_ALLOW_ORIGINS=*
